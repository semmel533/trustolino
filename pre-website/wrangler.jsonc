{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pre-website",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_CONVEX_URL": "https://charming-shrimp-686.eu-west-1.convex.cloud",
    "NEXT_PUBLIC_APP_URL": "https://www.trustolino.de"
  }
}
