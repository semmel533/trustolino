# Convex Deployment
CONVEX_DEPLOYMENT="dev:your-deployment-name"
CONVEX_DEPLOY_KEY="dev:your-deployment-name|your-deploy-key"
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-deployment.convex.site"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Mail Server Configuration (Double Opt-in)
SMTP_HOST="mail.your-server.de"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-user@trustolino.de"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="selim.eser@trustolino.de"
SMTP_FROM_NAME_DE="Selim von Trustolino"
SMTP_FROM_NAME_EN="Selim at Trustolino"
SMTP_REPLY_TO="noreply@trustolino.de"
